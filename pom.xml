<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.handyplus.guild.local</groupId>
    <artifactId>OpenPlayerGuild</artifactId>
    <version>2.21.3</version>
    <packaging>jar</packaging>
    <name>OpenPlayerGuild</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <repositories>

        <repository>
            <id>project-local</id>
            <url>file://${project.basedir}/repo</url>
        </repository>
        <repository>
            <id>spigot-snapshots</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
        <repository>
            <id>rosewood</id>
            <url>https://repo.rosewooddev.io/repository/public/</url>
        </repository>
        <repository>
            <id>onarandombox</id>
            <url>https://repo.onarandombox.com/content/groups/public/</url>
        </repository>
        <repository>
            <id>thenextlvl-releases</id>
            <url>https://repo.thenextlvl.net/releases</url>
        </repository>
        <repository>
            <id>userderezzed-snapshots</id>
            <url>https://repo.userderezzed.dev/snapshots</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>

        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.16.5-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.44</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>cn.handyplus.guild.local</groupId>
            <artifactId>PlayerGuild-lib</artifactId>
            <version>2.21.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/PlayerGuild-lib.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>cn.handyplus.guild.local</groupId>
            <artifactId>PlayerGuild-lib-orig</artifactId>
            <version>2.21.3</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.bukkit</groupId><artifactId>bukkit</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.sk89q.worldedit</groupId>
            <artifactId>worldedit-bukkit</artifactId>
            <version>7.2.14</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId></exclusion>
                <exclusion><groupId>org.bukkit</groupId><artifactId>bukkit</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.17.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.black_ixx</groupId>
            <artifactId>playerpoints</artifactId>
            <version>3.1.2</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId></exclusion>
                <exclusion><groupId>org.bukkit</groupId><artifactId>bukkit</artifactId></exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.onarandombox.multiversecore</groupId>
            <artifactId>Multiverse-Core</artifactId>
            <version>4.3.12</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId></exclusion>
                <exclusion><groupId>org.bukkit</groupId><artifactId>bukkit</artifactId></exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.mvplugins.multiverse.core</groupId>
            <artifactId>multiverse-core</artifactId>
            <version>5.8.2</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>net.thenextlvl</groupId>
            <artifactId>worlds</artifactId>
            <version>4.5.0</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId></exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.github.Zrips</groupId>
            <artifactId>Residence</artifactId>
            <version>6.0.2.3</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId></exclusion>
                <exclusion><groupId>org.bukkit</groupId><artifactId>bukkit</artifactId></exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>local.hooks</groupId><artifactId>MyPet</artifactId><version>3.14.3</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/MyPet-3.14.3.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>de.keyle</groupId>
            <artifactId>mypet-api</artifactId>
            <version>4.0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>local.hooks</groupId><artifactId>Adapt</artifactId><version>1.18.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/Adapt-1.18.0-1.20.2-1.21.10-thin.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local.hooks</groupId><artifactId>PlayerTitle</artifactId><version>5.5.6</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/PlayerTitle-5.5.6-free.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.hooks</groupId><artifactId>PlayerRace</artifactId><version>4.0.0</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/PlayerRace-4.0.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.hooks</groupId><artifactId>PlayerCurrency</artifactId><version>1.5.0</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/PlayerCurrency-1.5.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.hooks</groupId><artifactId>PlayerScoreboard</artifactId><version>1.2.1</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/PlayerScoreboard-1.2.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.hooks</groupId><artifactId>PlayerTask</artifactId><version>2.15.1</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/PlayerTask-2.15.1-free.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.hooks</groupId><artifactId>PlayerChat</artifactId><version>3.10.5</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/PlayerChat-3.10.5.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.hooks</groupId><artifactId>WorldBorder</artifactId><version>latest</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/WorldBorder.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.hooks</groupId><artifactId>MonsterAPI</artifactId><version>3.2.4</version>
            <scope>system</scope><systemPath>${project.basedir}/libs/MonsterAPI-3.2.4.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>8</release>
                    <proc>none</proc>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-Xlint:none</arg>
                        <arg>-nowarn</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <artifactSet>
                                <includes>
                                    <include>cn.handyplus.guild.local:PlayerGuild-lib-orig</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>cn.handyplus.guild.local:PlayerGuild-lib-orig</artifact>
                                    <excludes>

                                        <exclude>cn/handyplus/guild/lib/Mc.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Aa.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/InitApi.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/HandyHttpUtil.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/NetUtil.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/SignService.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/MetricsBase.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/bukkit/**</exclude>
                                        <exclude>cn/handyplus/guild/lib/charts/**</exclude>
                                        <exclude>cn/handyplus/guild/lib/json/**</exclude>
                                        <exclude>cn/handyplus/guild/lib/config/MetricsConfig.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/BA.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/mc.class</exclude>

                                        <exclude>cn/handyplus/guild/lib/Ca.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Ea.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Fb.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Hd.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Ka.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Ma.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Na.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Qa.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/VA.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Va.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/Xa.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/aa.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/ba.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/ca.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/fa.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/fb.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/fc.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/la.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/ma.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/na.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/nd.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/oa.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/pa.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/rc.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/sA.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/ta.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/td.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/ua.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/va.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/wa.class</exclude>
                                        <exclude>cn/handyplus/guild/lib/za.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
